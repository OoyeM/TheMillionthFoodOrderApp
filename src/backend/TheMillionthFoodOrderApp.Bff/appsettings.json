{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Authentication": {
    "UseMockAuth": false,
    "Cookie": {
      "SlidingExpirationHours": 8
    },
    "Keycloak": {
      "Authority": "",
      "ClientId": "bff-client",
      "ClientSecret": ""
    }
  },

  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api-destination": {
            "Address": "https+http://api"
          }
        }
      }
    }
  }
}
